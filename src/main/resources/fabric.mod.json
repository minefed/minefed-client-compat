{
  "schemaVersion": 1,
  "id": "minefed-client-compat",
  "version": "${version}",
  "name": "Minefed Client Compatibility",
  "description": "Fixes PTS-Deco recipes, PFM first-frame textures and DragonLib Wikidata requests on Minecraft 1.20.4 clients; removes redundant PFM/TrafficCraft work; reuses atlas transforms and model loading calculations; avoids repeated ordinary model parsing in Scena; and starts MCEF only when first used.",
  "authors": ["Minefed"],
  "license": "MIT",
  "environment": "*",
  "mixins": [
    {
      "config": "minefed-client-compat.mixins.json",
      "environment": "client"
    },
    {
      "config": "minefed-pfm-compat.mixins.json",
      "environment": "client"
    },
    {
      "config": "minefed-pfm-cache.mixins.json",
      "environment": "client"
    },
    {
      "config": "minefed-wikipedia-compat.mixins.json",
      "environment": "client"
    },
    "minefed-pfm-perf.mixins.json",
    {
      "config": "minefed-pfm-render-perf.mixins.json",
      "environment": "client"
    },
    "minefed-trafficcraft-perf.mixins.json",
    {
      "config": "minefed-trafficcraft-render-perf.mixins.json",
      "environment": "client"
    },
    {
      "config": "minefed-atlas-perf.mixins.json",
      "environment": "client"
    },
    {
      "config": "minefed-model-rotation.mixins.json",
      "environment": "client"
    },
    {
      "config": "minefed-model-variant-perf.mixins.json",
      "environment": "client"
    },
    {
      "config": "minefed-scena-model-cache.mixins.json",
      "environment": "client"
    },
    {
      "config": "minefed-mcef-lazy.mixins.json",
      "environment": "client"
    }
  ],
  "breaks": {
    "scena": ["<1.0.141", ">1.0.141"]
  },
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "=1.20.4",
    "java": ">=17",
    "ptsdeco": "=4.0.0",
    "pfm": "=1.5.0",
    "dragonlib": "=1.20.4-2.2.24",
    "trafficcraft": "=1.20.4-1.1.3"
  }
}
