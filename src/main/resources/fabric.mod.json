{
  "schemaVersion": 1,
  "id": "minefed-client-compat",
  "version": "${version}",
  "name": "Minefed Client Compatibility",
  "description": "Fixes PTS-Deco recipes, PFM first-frame textures and DragonLib Wikidata requests on Minecraft 1.20.4 clients, and removes redundant PFM stove updates, idle microwave lookups, empty furniture rendering work, unchanged TrafficCraft traffic-light updates and repeated TrafficCraft shape and bulb-model lookups, keeps block atlas sprites small and mipmap-aligned.",
  "authors": ["Minefed"],
  "license": "MIT",
  "environment": "*",
  "mixins": [
    {
      "config": "minefed-client-compat.mixins.json",
      "environment": "client"
    },
    {
      "config": "minefed-pfm-compat.mixins.json",
      "environment": "client"
    },
    {
      "config": "minefed-wikipedia-compat.mixins.json",
      "environment": "client"
    },
    "minefed-pfm-perf.mixins.json",
    {
      "config": "minefed-pfm-render-perf.mixins.json",
      "environment": "client"
    },
    "minefed-trafficcraft-perf.mixins.json",
    {
      "config": "minefed-trafficcraft-render-perf.mixins.json",
      "environment": "client"
    },
    {
      "config": "minefed-atlas-perf.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "=1.20.4",
    "java": ">=17",
    "ptsdeco": "=4.0.0",
    "pfm": "=1.5.0",
    "dragonlib": "=1.20.4-2.2.24",
    "trafficcraft": "=1.20.4-1.1.3"
  }
}
