{
  "schemaVersion": 1,
  "id": "minefed-client-compat",
  "version": "${version}",
  "name": "Minefed Client Compatibility",
  "description": "Fixes PTS-Deco 4.0.0 recipe synchronization and PFM 1.5.0 first-frame herringbone textures on Minecraft 1.20.4.",
  "authors": ["Minefed"],
  "license": "MIT",
  "environment": "client",
  "mixins": [
    {
      "config": "minefed-client-compat.mixins.json",
      "environment": "client"
    },
    {
      "config": "minefed-pfm-compat.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "=1.20.4",
    "java": ">=17",
    "ptsdeco": "=4.0.0",
    "pfm": "=1.5.0"
  }
}
